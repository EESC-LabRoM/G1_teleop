Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Spot
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.4
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Frames:
        All Enabled: false
        body:
          Value: true
        arm_link_sh0:
          Value: true
        arm_link_wr1:
          Value: true
        wrist_target:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: wrist_pose
      Shape: Axes
      Axes Length: 0.2
      Axes Radius: 0.02
      Topic:
        Value: /wrist_pose
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: RealSense
      Topic:
        Value: /camera/camera/color/image_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: body
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.2
      Pitch: 0.4
      Yaw: 2.6
      Name: Current View
      Value: Orbit (rviz)
